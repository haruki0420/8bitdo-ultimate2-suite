# Proprietary official binaries & installers (DO NOT COMMIT)
*.apk
*.exe
*.dll
*.pdb
*.lib
*.so
*.dylib
8BitDo_Ultimate_Software_V2_*/
# 公式ソフトの配布ディレクトリ（バージョン違いをまとめて除外）
8BitDo_Ultimate_Software_*/

# Official installers and archives (DO NOT COMMIT)
*.zip
*.7z
*.rar

# Official firmware images and device backups (DO NOT COMMIT)
# 公式ファームウェアは .dat / .bin / .hex / .uf2 / .img で配布され、
# バックアップはユーザーデータを含み得る。
*.dat
*.bin
*.hex
*.uf2
*.img
/firmware/
macro-backup-*/
config-backup-*/

# Test fixtures may legitimately contain .dat / .bin files.
# 規約: fixture は tests/fixtures/ または crates/<crate>/tests/fixtures/ に置く。
!tests/fixtures/**/*.dat
!tests/fixtures/**/*.bin
!crates/**/tests/fixtures/**/*.dat
!crates/**/tests/fixtures/**/*.bin

# Build artifacts & dependencies
target/
build/
dist/
out/
.gradle/
.build/
DerivedData/
*.xcarchive
*.ipa
*.aab

# Rust / Cargo
Cargo.lock.bak
**/*.rs.bk

# Android / Kotlin
local.properties
.idea/
*.iml
captures/
.cxx/

# iOS / Xcode / Swift
*.xcuserdata/
*.xcworkspace/xcuserdata/
.swiftpm/

# OS & Editor temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.env
.env.local

# Local GUI backups (normally under the XDG data directory)
8bitdo-backups/

# Mobile build artifacts (generated; never commit platform binaries)
mobile/ios/libs/
mobile/ios/RustCore/
mobile/ios/Sources/EightBitDo/Generated/
mobile/ios/xtool/
mobile/ios/.build/
mobile/ios/.bsp/
mobile/android/app/src/main/jniLibs/
mobile/android/app/src/main/java/dev/eightbitdo/mobile/core/
mobile/android/.gradle/
mobile/android/.kotlin/
mobile/android/build/
mobile/android/app/build/
mobile/android/local.properties

# Local agent scratch (RE / analysis) — keep the repo root clean
.tmp/
.re-scratch/
androguard.db*
androguard.log
