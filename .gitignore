# Proprietary official binaries & installers (DO NOT COMMIT)
*.apk
*.exe
*.dll
*.pdb
*.lib
*.so
*.dylib
8BitDo_Ultimate_Software_V2_*/

# Official firmware images and device backups (DO NOT COMMIT)
# 公式ファームウェアは .dat / .bin で配布され、バックアップはユーザーデータを含み得る。
*.dat
*.bin
/firmware/
macro-backup-*/
config-backup-*/

# Test fixtures may legitimately contain .dat / .bin files
!tests/fixtures/**/*.dat
!tests/fixtures/**/*.bin
!crates/**/tests/fixtures/**/*.dat
!crates/**/tests/fixtures/**/*.bin

# Build artifacts & dependencies
target/
build/
dist/
out/
.gradle/
.build/
DerivedData/
*.xcarchive
*.ipa
*.aab

# Rust / Cargo
Cargo.lock.bak
**/*.rs.bk

# Android / Kotlin
local.properties
.idea/
*.iml
captures/
.cxx/

# iOS / Xcode / Swift
*.xcuserdata/
*.xcworkspace/xcuserdata/
.swiftpm/

# OS & Editor temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.env
.env.local

# Local agent scratch (RE / analysis) — keep the repo root clean
.tmp/
.re-scratch/
androguard.db*
androguard.log
