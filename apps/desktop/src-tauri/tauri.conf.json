{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "8BitDo Ultimate 2",
  "version": "0.1.0",
  "identifier": "dev.eightbitdo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "8BitDo Ultimate 2",
        "width": 1120,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
